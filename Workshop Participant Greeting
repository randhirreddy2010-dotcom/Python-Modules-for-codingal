import tkinter as tk
from datetime import date
def check_in():
    name = name_entry.get()
    today = date.today().strftime("%B %d, %Y")
    output_text.delete(1.0, tk.END)
    message = f"Welcome to the Workshop, {name}!\n"
    message += f"We are excited to have you here.\n"
    message += f"Workshop Date: {today}"
    output_text.insert(tk.END, message)
root = tk.Tk()
root.title("Workshop Check-In")
root.geometry("400x350")
instruction_label = tk.Label(root, text="Please enter your name below:")
instruction_label.pack(pady=10)
name_entry = tk.Entry(root, width=30)
name_entry.pack(pady=5)
check_in_button = tk.Button(root, text="Check In", command=check_in)
check_in_button.pack(pady=15)
output_text = tk.Text(root, height=6, width=40)
output_text.pack(pady=10)
root.mainloop()