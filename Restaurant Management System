import tkinter as tk
from tkinter import ttk
from PIL import Image, ImageTk
root = tk.Tk()
root.title("Restaurant Menu")
root.geometry("600x500")
try:
    pil_image = Image.open("background.jpg").resize((600, 500))
    bg_image = ImageTk.PhotoImage(pil_image)
    bg_label = tk.Label(root, image=bg_image)
    bg_label.place(x=0, y=0, relwidth=1, relheight=1)
except Exception:
    print("Background image not found.")
frame = tk.Frame(root, bg="white", padx=20, pady=20)
frame.place(relx=0.5, rely=0.5, anchor="center")
tk.Label(frame, text="Order Menu", font=("Arial", 16, "bold"), bg="white").grid(row=0, column=0, columnspan=2, pady=10)
currency_box = ttk.Combobox(frame, values=("USD", "INR"), state="readonly", width=10)
currency_box.set("USD")
currency_box.grid(row=1, column=0, columnspan=2, pady=10)
menu_items = {
    "Burger": 5.99,
    "Pizza": 8.99,
    "Salad": 4.99,
    "Pasta": 7.99,
    "Soda": 1.99,
    "Coffee": 2.49,
    "Ice Cream": 3.49,
    "Fries": 2.99
}
entries = {} 
row_num = 2
for item, price in menu_items.items():
    tk.Label(frame, text=f"{item} (${price}):", bg="white").grid(row=row_num, column=0, sticky="e", pady=2)   
    entry = tk.Entry(frame, width=5)
    entry.grid(row=row_num, column=1, sticky="w", pady=2)   
    entries[item] = entry 
    row_num += 1
def calculate():
    total = 0
    rate = 83 if currency_box.get() == "INR" else 1
    symbol = "₹" if currency_box.get() == "INR" else "$"
    for item, price in menu_items.items():
        quantity = entries[item].get()
        if quantity.isdigit():
            total += int(quantity) * (price * rate)           
    result_label.config(text=f"Total: {symbol}{total:.2f}")
tk.Button(frame, text="Calculate Total", command=calculate, bg="lightgreen").grid(row=row_num, column=0, columnspan=2, pady=15)
result_label = tk.Label(frame, text="Total: $0.00", font=("Arial", 14, "bold"), bg="white")
result_label.grid(row=row_num+1, column=0, columnspan=2)
root.mainloop()