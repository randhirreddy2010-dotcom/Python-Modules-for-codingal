import tkinter as tk
def key_press(num):
    entry_pin.insert(tk.END, str(num))
def clear_pin():
    entry_pin.delete(0, tk.END)
def submit_details():
    account = entry_acc.get()
    pin = entry_pin.get()
    txt_output.delete(1.0, tk.END)
    if account and pin:
        txt_output.insert(tk.END, f"Account Number: {account}\n")
        txt_output.insert(tk.END, f"PIN successfully set! (Length: {len(pin)} digits)\n")
        txt_output.insert(tk.END, "Status: SECURED")
    else:
        txt_output.insert(tk.END, "System Error: Please enter both Account No. and PIN.")
root = tk.Tk()
root.title("ATM PIN Setup")
root.geometry("400x550")
form_frame = tk.Frame(root, relief=tk.SUNKEN, borderwidth=3)
form_frame.place(x=20, y=20, width=360, height=130)
lbl_title = tk.Label(form_frame, text="Enter Account Details", font=("Helvetica", 12, "bold"))
lbl_title.place(x=10, y=5)
lbl_acc = tk.Label(form_frame, text="Account No:")
lbl_acc.place(x=10, y=40)
entry_acc = tk.Entry(form_frame, width=25)
entry_acc.place(x=120, y=40)
lbl_pin = tk.Label(form_frame, text="Set New PIN:")
lbl_pin.place(x=10, y=80)
entry_pin = tk.Entry(form_frame, width=25, show="*")
entry_pin.place(x=120, y=80)
keypad_frame = tk.Frame(root, relief=tk.RAISED, borderwidth=3)
keypad_frame.place(x=100, y=170, width=200, height=210)
buttons = [
    ('1', 0, 0), ('2', 0, 1), ('3', 0, 2),
    ('4', 1, 0), ('5', 1, 1), ('6', 1, 2),
    ('7', 2, 0), ('8', 2, 1), ('9', 2, 2),
    ('Clear', 3, 0), ('0', 3, 1), ('Enter', 3, 2)
]
for (text, row, col) in buttons:
    if text == 'Clear':
        btn = tk.Button(keypad_frame, text=text, width=5, height=2, command=clear_pin)
    elif text == 'Enter':
        btn = tk.Button(keypad_frame, text=text, width=5, height=2, command=submit_details, bg="#4CAF50", fg="white")
    else:
        btn = tk.Button(keypad_frame, text=text, width=5, height=2, command=lambda t=text: key_press(t))
    btn.grid(row=row, column=col, padx=5, pady=5)
lbl_output = tk.Label(root, text="System Message:")
lbl_output.place(x=20, y=400)
txt_output = tk.Text(root, height=5, width=42, relief=tk.SUNKEN, borderwidth=2)
txt_output.place(x=20, y=425)
root.mainloop()