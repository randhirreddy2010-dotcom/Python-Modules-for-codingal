import tkinter as tk
from tkinter import messagebox
routines = ["Have a snack", "Do homework", "Play outside", "Pack bag for tomorrow"]
routine_step = 0
def on_keypress(event):
    char_typed = event.char
    if char_typed.strip() or char_typed.isalnum(): 
        last_char_label.config(text=f"Last character typed: {char_typed}")
def on_mouse_click(event):
    click_reaction_label.config(text="Routine Area Clicked! Stay focused!")
def submit_task():
    global routine_step
    task = task_entry.get().strip()
    if task == "":
        messagebox.showwarning("Warning", "Please enter a task before checking the routine!")
    else:
        if routine_step < len(routines):
            next_task_label.config(text=f"Next Task: {routines[routine_step]}")
            routine_step += 1
        else:
            next_task_label.config(text="Routine Complete! Great job today.")
            messagebox.showinfo("Done", "You have finished your entire after-school routine!")
root = tk.Tk()
root.title("After-School Routine Checker")
root.geometry("450x450")
root.configure(bg="#f0f8ff")
instruction_label = tk.Label(root, text="Type a task you just finished:", bg="#f0f8ff", font=("Arial", 12))
instruction_label.pack(pady=10)
task_entry = tk.Entry(root, width=30, font=("Arial", 12))
task_entry.pack(pady=5)
task_entry.bind("<Key>", on_keypress)
last_char_label = tk.Label(root, text="Last character typed: ", bg="#f0f8ff", fg="blue")
last_char_label.pack(pady=5)
submit_btn = tk.Button(root, text="Check Routine", command=submit_task, bg="#4CAF50", fg="white", font=("Arial", 10, "bold"))
submit_btn.pack(pady=15)
next_task_label = tk.Label(root, text="Next Task: Waiting for input...", bg="#f0f8ff", font=("Arial", 12, "bold"), fg="#d32f2f")
next_task_label.pack(pady=10)
routine_area = tk.Frame(root, width=300, height=100, bg="#ffeb3b", relief=tk.RAISED, borderwidth=3)
routine_area.pack(pady=20)
routine_area.pack_propagate(False) 
area_label = tk.Label(routine_area, text="Click inside this yellow Routine Area", bg="#ffeb3b", font=("Arial", 10, "italic"))
area_label.pack(pady=20)
routine_area.bind("<Button-1>", on_mouse_click)
area_label.bind("<Button-1>", on_mouse_click) 
click_reaction_label = tk.Label(root, text="", bg="#f0f8ff", fg="green", font=("Arial", 10, "bold"))
click_reaction_label.pack(pady=5)
root.mainloop()