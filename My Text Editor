from tkinter import*
from tkinter.filedialog import*
w = Tk()
w.title("My Text Editor")
w.geometry("600x500")
def open_file():
    f = askopenfilename(filetypes=[("Text Files", "*.txt"), ("All Files", "*.*")])
    if f:
        t.delete(1.0, END)
        with open(f, "r") as x:
            t.insert(END, x.read())
        w.title(f"My Text Editor - {f}")
def save_file():
    f = asksaveasfilename(defaultextension=".txt", filetypes=[("Text Files", "*.txt"), ("All Files", "*.*")])
    if f:
        with open(f, "w") as x:
            x.write(t.get(1.0, END))
        w.title(f"My Text Editor - {f}")    
b = Frame(w)  
Button(b, text="Open", command=open_file).pack(side=LEFT, padx=5, pady=5)
Button(b, text="Save", command=save_file).pack(side=LEFT, padx=5, pady=5)
b.pack(side = LEFT, fill=Y)
t = Text(w)
t.pack(side = RIGHT, fill = BOTH, expand = True)
w.mainloop()
