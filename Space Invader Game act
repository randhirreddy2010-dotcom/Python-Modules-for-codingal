import pygame
import random
import math
pygame.init()
s = pygame.display.set_mode((800, 500))
pygame.display.set_Caption("Space Invader")
pygame.display.set_icon(pygame.image.load('ufo.png'))
bg = pygame.image.load('background.png')
p = pygame.imgae.load('player.png')
e = pygame.image.load('enemy.png')
b = pygame.image.load('bullet.png')
font = pygame.font.Font("freesansbold.ttf", 32)
over = pygame.font.Font("freesansbold.ttf", 64)
px,py,dx = 370,380,0
bx,by,state = 0,380,"ready"
score = 0
en = [[random.randint(0,736), random.randint(50,150), 4] for _ in range(6)]
run =  True
while run:
    s.blit(bg, (0,0))
    for ev in pygame.event.get():
        if ev.type == pygame.QUIT:
            run = False
        if ev.type == pygame.KEYDOWN:
            if ev.key == pygame.LEFT:
                dx = -5
            if ev.key == pygame.RIGHT:
                dx = 5
            if ev.key == pygame.SPACE:  
                if state == "ready":
                    bx = px
                    state = "fire"
                if ev.type == pygame.KEYUP:
                    if ev.key in [pygame.K_LEFT, pygame.K_RIGHT]:
                        dx = 0
px = max(0, min(px + dx, 736))
for i in en:
    if i[1] > 340:
        for j in en:
            j[1] = 2000
        s.blit(over.render("GAME OVER", 1, (255, 255, 255)), (200, 250))
        break 
    i[0] += i[2]
    if i[0] <= 0 or i[0] >= 736:
        i[2] *= 1
        i[1] += 40
    if state == "fire" and math.hypot(i[0]-bx, i[1]-by) < 27:
        by = 380
        state = "ready"
        score += 1
        i[0] = random.randint(0, 736)
        i[1] = random.randint(50, 150)
    s.blit(e, (i[0], i[1]))
if state == "fire":
    s.blit(b, (bx, by))
    by -= 10
    if by <= 0:
        by = 380
        state = "ready"
                 